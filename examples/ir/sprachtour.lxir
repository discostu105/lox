# Sprachtour — jedes Konstrukt der IR-Sprache (docs/ir-spec.md) einmal
# im Bild, kompakt kommentiert. Kompiliert gegen
# examples/configs/pool.Loxone (zwei Seiten, Räume, Kategorien, ein
# GUI-gezeichneter Spiegel). Der erzählende Einstieg ist
# examples/ir/pool.lxir; die transienten Lebenszyklus-Statements
# `removed`/`moved` führt `cargo run --example lifecycle` vor.
# --- let: benannte Konstanten (Zahl und String) ------------------------

let frost_grenze = 3
let heiz_grenze = 26
let ort = "Außenbereich"

# --- extern: die Matcher-Palette ---------------------------------------
# uuid: pinnt exakt (nie mit room:/category:); iname: ist
# lokalisierungsstabil (VI1, AI3, …); title: ist menschenfreundlich —
# room: und category: machen ihn eindeutig, wo Titel sich wiederholen.

extern wassertemp = VirtualIn(uuid: "30000001-0000-0010-ffff504f94112233")
extern pv_ueberschuss = VirtualIn(iname: "VI2")
extern abdeckung = VirtualIn(iname: "VI3")
extern aussentemp = VirtualIn(iname: "VI4")
extern filterpumpe = Switch(title: "Freigabe", category: "Filterung")
extern waermepumpe = Switch(title: "Freigabe", room: "Technikraum")
extern stoerlampe = Switch(title: "Störmeldung")
extern netzbezug = VirtualIn(iname: "VI5")

# --- Seite "Pool" (D28): Blöcke landen auf der genannten Basis-Seite ---

page "Pool"

# Konstruktor-Syntax: optionales Label zuerst, dann Port-Bindungen —
# ein Wert wird Parameter (Def=), `slug.Port` wird Draht, ein Ausdruck
# desugart in diskrete Blöcke (D26).

heizbedarf = Less(
	"Wasser unter Soll",
	Input1: wassertemp.Q,
	Input2: heiz_grenze,
)

# Einheiten (D27): ms/s/min/h skalieren exakt in Sekunden, K und %
# annotieren mit Faktor 1 — `80%` kompiliert zu Def="80".

weit_offen = GreaterEqual(
	"Abdeckung weit offen",
	Input1: abdeckung.Q,
	Input2: 80%,
)

# Fan-in: mehrere Drähte auf DENSELBEN Port sind erlaubt, solange die
# Quellen verschieden sind; dazu ein Ausdruck als Argument.

anforderung = Or(
	I1: heizbedarf.Q,
	I1: weit_offen.Q,
	I2: pv_ueberschuss.Q >= 1500,
)

# Attribut-Parameter: `Formula:` liegt im XML als Element-Attribut,
# bindet aber wie jeder Parameter — nur ein Draht ist unmöglich.

mitteltemp = Formula(
	"Mittel aus Wasser und Luft",
	Formula: "(I1+I2)/2",
	Input1: wassertemp.Q,
	Input2: aussentemp.Q,
)

# Zeit-Einheiten am Parameter: 45min → Def="2700", 1.5h → Def="5400".

takt = PulseGen(
	"Umwälz-Takt",
	TimeHigh: 45min,
	TimeLow: 1.5h,
)

# `==`/`!=` vergleichen auch digitale Signale; das Memory hält den
# Vergleichswert.

speicher = Memory(
	Input: waermepumpe.Q == 1,
)

# --- template (D23): Titel-Interpolation, Defaults, Forwarding ---------
# Ein Ein-Block-Template ist ein zusammengesetzter Block: "{titel}"
# setzt pro Instanz den App-Titel, Wert-Parameter tragen Defaults, und
# eine Bindung, die keinen Parameter nennt, wird als Port-Bindung an
# den Körperblock durchgereicht.

template grenzwaechter(quelle: VirtualIn, titel = "Wächter", ein = 30, aus = 28)
	alarm = AnalogThresholdTrigger(
		"{titel}: über Grenze",
		Input: quelle.Q,
		On: ein,
		Off: aus,
	)
end

hitze = grenzwaechter(
	quelle: aussentemp,
	titel: ort, # let-Referenz als Argument
)

uebertemp = grenzwaechter(
	quelle: wassertemp,
	titel: "Wasser zu warm",
	ein: 32, # Default überschrieben
	aus: 30,
	PulseTime: 10s, # Forwarding auf den Körperblock
)

# Ausdruck am Extern-Draht (D24): or, and, Klammern, Vergleich. Nur
# bedeutungstragende Klammern bleiben stehen — redundante entfernt die
# kanonische Form (eine Schreibweise pro Fakt).

filterpumpe.On <- takt.Q and (anforderung.Q or aussentemp.Q <= 0) # Frostschutz zählt als Anforderung

# --- Seite "Technik": Spiegel (Refs) und die zweite Seite --------------

page "Technik"

# D32: ein GUI-gezeichneter Spiegel wird per `mirrors:` gematcht — die
# Behauptung "spiegelt netzbezug" wird bei jedem Compile geprüft.

extern netz_spiegel = InputRef(mirrors: netzbezug)

# D34: ein Draht, der hier `netzbezug.Q` nennt, wird automatisch über
# den Spiegel der eigenen Seite gezogen (netz_spiegel.AQ) — genau wie
# die GUI ihn zeichnen würde.

netz_hoch = GreaterEqual(
	"Netzbezug hoch",
	Input1: netzbezug.Q, # tatsächlich verdrahtet: netz_spiegel.AQ
	Input2: 2000,
)

# D33: einen Spiegel selbst prägen — der Titel kommt vom Ziel, der
# Speise-Draht (AI <- Ziel-Ausgang) steht explizit in der Quelle. Ein
# Draht, der den Ref selbst nennt, bleibt wörtlich (kein D34-Umweg).

wasser_spiegel = InputRef(
	mirrors: wassertemp,
	AI: wassertemp.Q,
)

kalt_technik = Less(
	"Wasser kalt (Technik)",
	Input1: wasser_spiegel.AQ,
	Input2: frost_grenze,
)

# Millisekunden-Einheiten: 250ms → Def="0.25".

blitz = PulseGen(
	"Störblitz",
	TimeHigh: 250ms,
	TimeLow: 750ms,
)

stoerung = And(
	I1: kalt_technik.Q,
	I2: blitz.Q,
)

stoerlampe.On <- stoerung.Q

# --- test (D36): clock, dt-Schritte, ~= --------------------------------
# `lxir test` kompiliert im Speicher und spielt jedes Szenario mit
# `lox sim` durch; Referenzen zeigen auf das flache Modul (Templates
# expandiert, Ausdrücke desugart). Injizierte Signale tragen hier
# eindeutige Titel — der Simulator adressiert per Titel, und ein Titel,
# den auch ein Spiegel trägt, ist keine stabile Adresse.

test "Hitzewarnung mit Hysterese"
	clock "2026-07-15 14:00" # simulierte Uhrzeit, für Zeitlogik
	aussentemp.Q = 35
	tick 4
	expect hitze_alarm.Q == 1
	aussentemp.Q = 29 # unter Ein (30), über Aus (28)
	tick 4 dt 500ms # feinere Simulationsschritte
	expect hitze_alarm.Q == 1 # Hysterese hält
	aussentemp.Q = 20
	tick 4
	expect hitze_alarm.Q ~= 0 # ~= toleriert 5 %
end

test "Abdeckungswächter schaltet"
	abdeckung.Q = 90
	tick 4
	expect weit_offen.Q == 1
	expect anforderung.Q == 1 # Fan-in: ein I1-Draht genügt
	abdeckung.Q = 30
	tick 4
	expect weit_offen.Q == 0
end
