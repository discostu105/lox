{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "loxl",
  "scopeName": "source.loxl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#template" },
    { "include": "#test" },
    { "include": "#tiles" },
    { "include": "#access" },
    { "include": "#moods" },
    { "include": "#rule" },
    { "include": "#schedule" },
    { "include": "#end" },
    { "include": "#page" },
    { "include": "#extern" },
    { "include": "#let" },
    { "include": "#removed" },
    { "include": "#moved" },
    { "include": "#block" },
    { "include": "#instance" },
    { "include": "#signal" },
    { "include": "#wire" },
    { "include": "#attr" },
    { "include": "#set" },
    { "include": "#exprops" },
    { "include": "#portref" },
    { "include": "#string" },
    { "include": "#bool" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.loxl",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.loxl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.loxl",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },
    "bool": {
      "comment": "on/off, the boolean literals (D80)",
      "name": "constant.language.boolean.loxl",
      "match": "(?<![\\w.])(on|off)(?![\\w.])"
    },
    "number": {
      "match": "(?<![\\w.])(-?[0-9]+(?:\\.[0-9]+)?)(ms|min|h|s|K|%)?(?![\\w.])",
      "captures": {
        "1": { "name": "constant.numeric.loxl" },
        "2": { "name": "keyword.other.unit.loxl" }
      }
    },
    "exprops": {
      "patterns": [
        {
          "name": "keyword.operator.logical.loxl",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.loxl",
          "match": ">=|<=|==|!=|~=|<(?!-)|>"
        },
        {
          "name": "keyword.operator.arithmetic.loxl",
          "match": "[+*/]|(?<=[\\w)])\\s*-(?![0-9>])"
        }
      ]
    },
    "portref": {
      "match": "([a-z][a-z0-9_]*)(\\.)([A-Za-z0-9_]+)",
      "captures": {
        "1": { "name": "variable.other.loxl" },
        "2": { "name": "punctuation.accessor.loxl" },
        "3": { "name": "variable.other.member.loxl" }
      }
    },
    "page": {
      "match": "^\\s*(page)\\b",
      "captures": {
        "1": { "name": "keyword.control.page.loxl" }
      }
    },
    "template": {
      "begin": "^\\s*(template)\\s+([a-z][a-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.template.loxl" },
        "2": { "name": "entity.name.function.loxl" },
        "3": { "name": "punctuation.definition.parameters.begin.loxl" }
      },
      "end": "(\\))(?:\\s*(->)\\s*([a-z][a-z0-9_]*))?",
      "endCaptures": {
        "1": { "name": "punctuation.definition.parameters.end.loxl" },
        "2": { "name": "keyword.operator.primary.loxl" },
        "3": { "name": "variable.other.primary.loxl" }
      },
      "patterns": [
        {
          "match": "([a-z][a-z0-9_]*)\\s*(:)\\s*(moods|schedule|tiles|any)\\b",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "punctuation.separator.loxl" },
            "3": { "name": "storage.type.set.loxl" }
          }
        },
        {
          "match": "([a-z][a-z0-9_]*)\\s*(:)\\s*([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "punctuation.separator.loxl" },
            "3": { "name": "entity.name.type.loxl" }
          }
        },
        {
          "match": "([a-z][a-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "keyword.operator.assignment.loxl" }
          }
        },
        { "include": "#string" },
        { "include": "#number" }
      ]
    },
    "end": {
      "name": "keyword.control.end.loxl",
      "match": "^\\s*(end)\\s*$"
    },
    "test": {
      "patterns": [
        {
          "match": "^\\s*(test)\\s+(?=\")",
          "captures": {
            "1": { "name": "keyword.control.test.loxl" }
          }
        },
        {
          "match": "^\\s*(tick)\\s+([0-9]+(?:\\.[0-9]+)?)(ms|min|h|s)?(?:\\s+(dt)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.tick.loxl" },
            "2": { "name": "constant.numeric.loxl" },
            "3": { "name": "keyword.other.unit.loxl" },
            "4": { "name": "keyword.control.dt.loxl" }
          }
        },
        {
          "match": "^\\s*(expect)\\b",
          "captures": {
            "1": { "name": "keyword.control.expect.loxl" }
          }
        },
        {
          "match": "^\\s*(clock)\\s+((?:[0-9]{4}-[0-9]{2}-[0-9]{2}\\s+)?[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)",
          "captures": {
            "1": { "name": "keyword.control.clock.loxl" },
            "2": { "name": "constant.numeric.time.loxl" }
          }
        }
      ]
    },
    "rule": {
      "comment": "rule <slug> [\"Name\"] \u2026 end with active/inactive, when time HH:MM, when weekday <days>, then <slug> <command> lines (D57; one-word commands bare, D80)",
      "begin": "^\\s*(rule)\\s+([a-z][a-z0-9_]*)(?:\\s+(?=\"))?",
      "beginCaptures": {
        "1": { "name": "keyword.control.rule.loxl" },
        "2": { "name": "entity.name.function.loxl" }
      },
      "end": "^\\s*(end)\\s*$",
      "endCaptures": { "1": { "name": "keyword.control.end.loxl" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#bool" },
        {
          "match": "^\\s*(active|inactive)\\s*(?=$|#)",
          "captures": { "1": { "name": "constant.language.loxl" } }
        },
        {
          "match": "^\\s*(when)\\s+(time)\\b",
          "captures": {
            "1": { "name": "keyword.control.when.loxl" },
            "2": { "name": "keyword.other.rule.loxl" }
          }
        },
        {
          "begin": "^\\s*(when)\\s+(weekday)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.when.loxl" },
            "2": { "name": "keyword.other.rule.loxl" }
          },
          "end": "(?=$|#)",
          "patterns": [{ "include": "#day" }]
        },
        {
          "match": "^\\s*(then)\\s+([a-z][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.then.loxl" },
            "2": { "name": "variable.other.loxl" }
          }
        },
        { "include": "#number" }
      ]
    },
    "schedule": {
      "comment": "schedule <name> \u2026 end with <days> HH:MM-HH:MM[ = <value>][ activate], \u2026 or <days> off lines (D53)",
      "begin": "^\\s*(schedule)\\s+([a-z][a-z0-9_]*)\\s*(?=$|#)",
      "beginCaptures": {
        "1": { "name": "keyword.control.schedule.loxl" },
        "2": { "name": "entity.name.function.loxl" }
      },
      "end": "^\\s*(end)\\s*$",
      "endCaptures": { "1": { "name": "keyword.control.end.loxl" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#day" },
        { "match": "\\b(off|activate)\\b", "name": "constant.language.loxl" },
        { "include": "#number" }
      ]
    },
    "day": {
      "name": "constant.language.day.loxl",
      "match": "\\b(mon|tue|wed|thu|fri|sat|sun|weekdays|weekend|daily|holiday|vacation|dayoff|heating|cooling)\\b"
    },
    "moods": {
      "comment": "moods <name> … end with \"<title>\": all on, AQ1 temp(80%, 4700K) lines (D58)",
      "patterns": [
        {
          "match": "^\\s*(moods)\\s+([a-z][a-z0-9_]*)\\s*(?=$|#)",
          "captures": {
            "1": { "name": "keyword.control.moods.loxl" },
            "2": { "name": "entity.name.function.loxl" }
          }
        },
        {
          "match": "\\b(all)\\s+(on|off)\\b",
          "captures": {
            "1": { "name": "keyword.other.moods.loxl" },
            "2": { "name": "constant.language.loxl" }
          }
        },
        {
          "match": "\\b(rgb|temp)(?=\\()",
          "name": "support.function.builtin.loxl"
        },
        {
          "match": "\\b(AQ[0-9]+)\\s+(temp|rgb|on|off)\\b",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "keyword.other.moods.loxl" }
          }
        }
      ]
    },
    "tiles": {
      "comment": "tiles <name> … end with tile <i>(…) entries (D41)",
      "patterns": [
        {
          "match": "^\\s*(tiles)\\s+([a-z][a-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.tiles.loxl" },
            "2": { "name": "entity.name.function.loxl" }
          }
        },
        {
          "match": "^\\s*(tile)\\s+([0-9]+)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.control.tile.loxl" },
            "2": { "name": "constant.numeric.loxl" }
          }
        },
        {
          "match": "\\b((?:click|up|down)(?:_(?:text|to))?|text|to)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "punctuation.separator.loxl" }
          }
        }
      ]
    },
    "access": {
      "comment": "access <code_touch> … end with user/group \"<title>\": \"<schedule>\" grants (D49); recipients <notification> … end with user/group \"<title>\" (D51)",
      "patterns": [
        {
          "match": "^\\s*(access|recipients)\\s+([a-z][a-z0-9_]*)\\s*(?=$|#)",
          "captures": {
            "1": { "name": "keyword.control.access.loxl" },
            "2": { "name": "variable.other.loxl" }
          }
        },
        {
          "match": "^\\s*(user|group)\\s+(?=\")",
          "captures": {
            "1": { "name": "keyword.other.access.loxl" }
          }
        }
      ]
    },
    "file": {
      "comment": "file(\"…\") — program text from a file (D40); one match, so its ) never closes the argument list",
      "match": "\\b(file)\\s*(\\()\\s*(\"[^\"]*\")\\s*(\\))",
      "captures": {
        "1": { "name": "support.function.builtin.loxl" },
        "2": { "name": "punctuation.definition.arguments.begin.loxl" },
        "3": { "name": "string.quoted.double.loxl" },
        "4": { "name": "punctuation.definition.arguments.end.loxl" }
      }
    },
    "extern": {
      "match": "^\\s*(extern)\\s+([a-z][a-z0-9_]*)\\s*(=)\\s*([A-Z][A-Za-z0-9]*)\\s*(\\()\\s*(uuid|iname|title|mirrors)\\s*(:)",
      "captures": {
        "1": { "name": "keyword.control.extern.loxl" },
        "2": { "name": "entity.name.function.loxl" },
        "3": { "name": "keyword.operator.assignment.loxl" },
        "4": { "name": "entity.name.type.loxl" },
        "5": { "name": "punctuation.definition.arguments.begin.loxl" },
        "6": { "name": "constant.language.matchkind.loxl" },
        "7": { "name": "punctuation.separator.loxl" }
      }
    },
    "block": {
      "begin": "^\\s*([a-z][a-z0-9_]*)\\s*(=)\\s*([A-Z][A-Za-z0-9]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.function.loxl" },
        "2": { "name": "keyword.operator.assignment.loxl" },
        "3": { "name": "entity.name.type.loxl" },
        "4": { "name": "punctuation.definition.arguments.begin.loxl" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.arguments.end.loxl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#file" },
        { "include": "#string" },
        {
          "match": "([A-Za-z][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "punctuation.separator.loxl" }
          }
        },
        { "include": "#exprops" },
        { "include": "#portref" },
        { "include": "#number" }
      ]
    },
    "signal": {
      "comment": "a named signal (D81): name = <expression>, after block and instance",
      "match": "^\\s*([a-z][a-z0-9_]*)\\s*(=)(?!=)",
      "captures": {
        "1": { "name": "entity.name.function.loxl" },
        "2": { "name": "keyword.operator.assignment.loxl" }
      }
    },
    "instance": {
      "begin": "^\\s*([a-z][a-z0-9_]*)\\s*(=)\\s*([a-z][a-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.function.loxl" },
        "2": { "name": "keyword.operator.assignment.loxl" },
        "3": { "name": "entity.name.function.template.loxl" },
        "4": { "name": "punctuation.definition.arguments.begin.loxl" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.arguments.end.loxl" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#file" },
        { "include": "#string" },
        {
          "match": "([A-Za-z][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.loxl" },
            "2": { "name": "punctuation.separator.loxl" }
          }
        },
        { "include": "#portref" },
        { "include": "#number" }
      ]
    },
    "wire": {
      "match": "^\\s*([a-z][a-z0-9_]*)(\\.)([A-Za-z0-9_]+)\\s*(<-)",
      "captures": {
        "1": { "name": "variable.other.loxl" },
        "2": { "name": "punctuation.accessor.loxl" },
        "3": { "name": "variable.other.member.loxl" },
        "4": { "name": "keyword.operator.arrow.loxl" }
      }
    },
    "attr": {
      "match": "^\\s*([a-z][a-z0-9_]*)(\\.)(title|room|category|tiles)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.loxl" },
        "2": { "name": "punctuation.accessor.loxl" },
        "3": { "name": "support.type.property-name.loxl" },
        "4": { "name": "keyword.operator.assignment.loxl" }
      }
    },
    "set": {
      "match": "^\\s*([a-z][a-z0-9_]*)(\\.)([A-Za-z0-9_]+)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.loxl" },
        "2": { "name": "punctuation.accessor.loxl" },
        "3": { "name": "variable.other.member.loxl" },
        "4": { "name": "keyword.operator.assignment.loxl" }
      }
    },
    "let": {
      "match": "^\\s*(let)\\s+([a-z][a-z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.control.let.loxl" },
        "2": { "name": "variable.other.constant.loxl" },
        "3": { "name": "keyword.operator.assignment.loxl" }
      }
    },
    "removed": {
      "match": "^\\s*(removed)\\s+([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.removed.loxl" },
        "2": { "name": "variable.other.loxl" }
      }
    },
    "moved": {
      "match": "^\\s*(moved)\\s+([a-z][a-z0-9_]*)\\s*(->)\\s*([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.moved.loxl" },
        "2": { "name": "variable.other.loxl" },
        "3": { "name": "keyword.operator.arrow.loxl" },
        "4": { "name": "variable.other.loxl" }
      }
    }
  }
}
