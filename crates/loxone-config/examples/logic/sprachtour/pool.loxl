# Sprachtour — jedes Konstrukt der Lox-Logic-Sprache (docs/language.md) einmal
# im Bild, kompakt kommentiert. Kompiliert gegen
# examples/configs/pool.Loxone (zwei Seiten, Räume, Kategorien, ein
# GUI-gezeichneter Spiegel). Ein Modul aus zwei Dateien, eine je Seite;
# die Namen gelten über beide. Der erzählende Einstieg ist
# examples/logic/pool.loxl; die transienten Lebenszyklus-Statements
# `removed`/`moved` führt `cargo run --example lifecycle` vor.

# --- page (D28): der Dateikopf. Die Blöcke der Datei landen auf der
# genannten Basis-Seite. ------------------------------------------------

page "Pool"

# --- let: benannte Konstanten (Zahl und String) ------------------------

let frost_grenze = 3
let heiz_grenze = 26
let ort = "Außenbereich"

# --- extern: die Matcher-Palette ---------------------------------------
# uuid: pinnt exakt (nie mit room:/category:); iname: ist
# lokalisierungsstabil (VI1, AI3, …); title: ist menschenfreundlich —
# room: und category: machen ihn eindeutig, wo Titel sich wiederholen.

extern wassertemp = VirtualIn(uuid: "30000001-0000-0010-ffff504f94112233")
extern pv_ueberschuss = VirtualIn(iname: "VI2")
extern abdeckung = VirtualIn(iname: "VI3")
extern aussentemp = VirtualIn(iname: "VI4")
extern filterpumpe = Switch(title: "Freigabe", category: "Filterung")
extern waermepumpe = Switch(title: "Freigabe", room: "Technikraum")
extern stoerlampe = Switch(title: "Störmeldung")
extern netzbezug = VirtualIn(iname: "VI5")

# Konstruktor-Syntax: optionales Label zuerst, dann Port-Bindungen —
# ein Wert wird Parameter (Def=), `slug.Port` wird Draht, ein Ausdruck
# desugart in diskrete Blöcke (D26).

heizbedarf = Less("Wasser unter Soll", In1: wassertemp.Q, In2: heiz_grenze)

# Einheiten (D27): ms/s/min/h skalieren exakt in Sekunden, K und %
# annotieren mit Faktor 1 — `80%` kompiliert zu Def="80".

weit_offen = GreaterEqual("Abdeckung weit offen", In1: abdeckung.Q, In2: 80%)

# Fan-in: mehrere Quellen auf DEMSELBEN Port stehen in einer Liste;
# dazu ein Ausdruck als Argument.

anforderung = Or(In1: [heizbedarf.Q, weit_offen.Q], In2: pv_ueberschuss.Q >= 1500)

# Attribut-Parameter: `Formula:` liegt im XML als Element-Attribut,
# bindet aber wie jeder Parameter — nur ein Draht ist unmöglich.

mitteltemp = Formula(
	"Mittel aus Wasser und Luft",
	Formula: "(I1+I2)/2",
	In1: wassertemp.Q,
	In2: aussentemp.Q,
)

# Zeit-Einheiten am Parameter: 45min → Def="2700", 1.5h → Def="5400".

takt = PulseGen("Umwälz-Takt", OnTime: 45min, OffTime: 1.5h)

# `==`/`!=` vergleichen auch digitale Signale; das Memory hält den
# Vergleichswert.

speicher = Memory(In: waermepumpe.Q == 1)

# --- template (D23): Titel-Interpolation, Defaults, Forwarding ---------
# Ein Ein-Block-Template ist ein zusammengesetzter Block: "{titel}"
# setzt pro Instanz den App-Titel, Wert-Parameter tragen Defaults, und
# eine Bindung, die keinen Parameter nennt, wird als Port-Bindung an
# den Körperblock durchgereicht. Der einzige Block ist der Hauptblock:
# `hitze.Q` liest ihn (D82); bei mehreren Blöcken heißt einer
# `hitze.<block>.Q`, und `template name(…) -> <block>` macht einen zum
# Hauptblock.

template grenzwaechter(quelle: VirtualIn, titel = "Wächter", ein = 30, aus = 28)
	alarm = AnalogThresholdTrigger(
		"{titel}: über Grenze",
		In: quelle.Q,
		On: ein,
		Off: aus,
	)
end

hitze = grenzwaechter(
	quelle: aussentemp,
	titel: ort, # let-Referenz als Argument
)

uebertemp = grenzwaechter(
	quelle: wassertemp,
	titel: "Wasser zu warm",
	ein: 32, # Default überschrieben
	aus: 30,
	PulseTime: 10s, # Forwarding auf den Körperblock
)

# Ausdruck am Extern-Draht (D24): or, and, Klammern, Vergleich. Nur
# bedeutungstragende Klammern bleiben stehen — redundante entfernt die
# kanonische Form (eine Schreibweise pro Fakt).

filterpumpe.On <- takt.Q
	and (anforderung.Q or aussentemp.Q <= 0) # Frostschutz zählt als Anforderung

# --- test (D36, D80): clock, Dauer, dt-Schritte, ~=, != ----------------
# `loxl test` kompiliert im Speicher und spielt jedes Szenario im
# eingebauten Simulator durch; Referenzen zeigen auf das flache Modul
# (Templates expandiert, Ausdrücke desugart). Injizierte Signale tragen
# hier eindeutige Titel — so laufen die Szenarien auch in lox-cli
# (`--lox`), das per Titel adressiert.

test "Hitzewarnung mit Hysterese"
	clock 2026-07-15 14:00 # simulierte Uhrzeit, für Zeitlogik
	aussentemp.Q = 35
	step 4
	expect hitze.Q == 1
	aussentemp.Q = 29 # unter Ein (30), über Aus (28)
	tick 2s dt 500ms # zwei Sekunden in feineren Schritten (4 Ticks)
	expect hitze.Q == 1 # Hysterese hält
	aussentemp.Q = 20
	step 4
	expect hitze.Q ~= 0 # ~= toleriert 5 %
end

test "Abdeckungswächter schaltet"
	abdeckung.Q = 90
	step 4
	expect weit_offen.Q == on # digitale Werte: on/off
	expect anforderung.Q == 1 # Fan-in: ein I1-Draht genügt
	abdeckung.Q = 30
	step 4
	expect weit_offen.Q != on
end
