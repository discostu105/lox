page "Beschattung Wohnzimmer"

extern windgeschwindigkeit = TreeAsensor(title: "Windgeschwindigkeit") # periphery
extern windwarnung = TreeSensor(title: "Windwarnung") # periphery
extern temperatur = TreeAsensor(uuid: "218a0e3b-020e-4e40-ffffed57184a04d2") # periphery
extern sonnenschein = TreeSensor(title: "Sonnenschein") # periphery
extern taste_links_oben = TreeSensor(title: "Taste links oben") # periphery
extern taste_links_unten = TreeSensor(title: "Taste links unten") # periphery
extern raffstore_sued_ab = Actor(iname: "Q2", In: raffstore_sued.MotorDown) # periphery
extern raffstore_sued_auf = Actor(iname: "Q1", In: raffstore_sued.MotorUp) # periphery
extern raffstore_west_ab = Actor(iname: "Q4", In: raffstore_west.MotorDown) # periphery
extern raffstore_west_auf = Actor(iname: "Q3", In: raffstore_west.MotorUp) # periphery

wind_ueber_40_km_h = Greater(In1: windgeschwindigkeit, In2: 40)
windalarm = Or(In1: wind_ueber_40_km_h, In2: windwarnung)
windalarm_halten = OffDelay(Trigger: windalarm, Time: 10min)
aussen_ueber_22_c = Greater(In1: temperatur, In2: 22)
sonne_und_warm = And(In1: sonnenschein, In2: aussen_ueber_22_c)

raffstore_sued = AutoJalousie(
	TriggerUp: taste_links_oben,
	TriggerDown: taste_links_unten,
	AutoShade: sonne_und_warm,
	Safety: windalarm_halten,
	Type: 1,
	OpenTime: 1min,
	CloseTime: 58s,
	AutoShadeEnd: 0,
	AutoShadeMode: 0,
	LongClick: 0,
	DoubleClick: 0,
	DirToleranceIn: 0,
	DirToleranceOut: 0,
	AutoShadeTime: 0,
	SunriseOffset: 0,
	SunsetOffset: 0,
	SlatWidth: 0,
	SlatSpacing: 0,
	MotorLock: 0,
	BacklashReverse: 0,
	MinTravel: 0,
	ReturnTime: 0,
)

raffstore_west = AutoJalousie(
	TriggerUp: taste_links_oben,
	TriggerDown: taste_links_unten,
	AutoShade: sonne_und_warm,
	Safety: windalarm_halten,
	Type: 1,
	Dir: 270,
	OpenTime: 1min,
	CloseTime: 58s,
	AutoShadeEnd: 0,
	AutoShadeMode: 0,
	LongClick: 0,
	DoubleClick: 0,
	DirToleranceIn: 0,
	DirToleranceOut: 0,
	AutoShadeTime: 0,
	SunriseOffset: 0,
	SunsetOffset: 0,
	SlatWidth: 0,
	SlatSpacing: 0,
	MotorLock: 0,
	BacklashReverse: 0,
	MinTravel: 0,
	ReturnTime: 0,
)
