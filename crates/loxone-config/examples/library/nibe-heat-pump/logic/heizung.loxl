page "Heizung"

extern heizungsmodus = Radio(title: "Heizungsmodus")
extern anwesenheitsmodus_heizung = Radio(title: "Anwesenheitsmodus Heizung")
extern bad_temperatur_2 = InputRef(mirrors: bad_temperatur)
extern bad_zieltemperatur_2 = InputRef(mirrors: bad_zieltemperatur)
extern urlaub = InputRef(title: "Urlaub") # mirrors Mode "Urlaub"
extern alle_sind_zu_hause_2 = InputRef(mirrors: alle_sind_zu_hause)
extern aussentemperatur_gemittelt = VirtualHttpInCmd(iname: "VCI22") # periphery
extern heizungsstop = Constant(title: "Heizungsstop") # periphery

betriebsmodus_heizung = State(
	I1: heizungsmodus.AQ,
	I2: o752.Q,
)

o752 = LessEqual(
	Input1: aussentemperatur_gemittelt.AQ,
	Input2: heizungsstop.AQ,
)

loxone_2_nibe_temp = State(
	I1: bad_temperatur_2.Q,
	I2: bad_zieltemperatur_2.Q,
)

loxone_2_nibe_mode = State(
	I1: anwesenheitsmodus_heizung.AQ,
)

heisswasser_boost = PushButton(
	Reset: autoreset_nach_3h.Q,
)

autoreset_nach_3h = OnPulseDelay(
	InputTrigger: heisswasser_boost.Qon,
	Reset: heisswasser_boost.Qoff,
	Delay: 10800,
	Time: 0.5,
)

o17795 = Monoflop(
	Reset: urlaub.AQ,
	Time: 2,
)

o17795_2 = Monoflop(
	"O17795",
	InputTrigger: alle_sind_zu_hause_2.Q,
	Reset: urlaub.AQ,
	Time: 2,
)

o17795_3 = Monoflop(
	"O17795",
	InputTrigger: urlaub.AQ,
	Time: 2,
)

o17795_4 = Monoflop(
	"O17795",
	Time: 2,
)

alle_sind_zu_hause = Memory()
bad_temperatur = Memory()
bad_zieltemperatur = Memory()

anwesenheitsmodus_heizung.Reset <- o17795_2.Q
anwesenheitsmodus_heizung.Reset <- o17795_4.Q
