page "Heizung"

defaults Monoflop(Time: 2s)

extern heizungsmodus = Radio(title: "Heizungsmodus")

extern anwesenheitsmodus_heizung = Radio(
	title: "Anwesenheitsmodus Heizung",
	Reset: o17795_2,
	Reset: o17795_4,
)

extern bad_temperatur_2 = InputRef(mirrors: bad_temperatur)
extern bad_zieltemperatur_2 = InputRef(mirrors: bad_zieltemperatur)
extern urlaub = InputRef(title: "Urlaub") # mirrors Mode "Urlaub"
extern alle_sind_zu_hause_2 = InputRef(mirrors: alle_sind_zu_hause)
extern aussentemperatur_gemittelt = VirtualHttpInCmd(iname: "VCI22") # periphery
extern heizungsstop = Constant(title: "Heizungsstop") # periphery

betriebsmodus_heizung = State(In1: heizungsmodus.AQ, In2: o752)
o752 = LessEqual(In1: aussentemperatur_gemittelt, In2: heizungsstop.AQ)
loxone_2_nibe_temp = State(In1: bad_temperatur_2.Q, In2: bad_zieltemperatur_2.Q)
loxone_2_nibe_mode = State(In1: anwesenheitsmodus_heizung.AQ)
heisswasser_boost = PushButton(Reset: autoreset_nach_3h)

autoreset_nach_3h = OnPulseDelay(
	Trigger: heisswasser_boost.Qon,
	Reset: heisswasser_boost.Qoff,
	Delay: 3h,
	PulseTime: 500ms,
)

o17795 = Monoflop(Reset: urlaub.AQ)
o17795_2 = Monoflop("O17795", Trigger: alle_sind_zu_hause_2.Q, Reset: urlaub.AQ)
o17795_3 = Monoflop("O17795", Trigger: urlaub.AQ)
o17795_4 = Monoflop("O17795")
alle_sind_zu_hause = Memory()
bad_temperatur = Memory()
bad_zieltemperatur = Memory()
