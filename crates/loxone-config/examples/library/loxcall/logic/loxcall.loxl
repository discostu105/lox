page "_LoxCall"

extern callstateoutput_2 = InputRef(uuid: "1713f389-0398-feb1-ffff4268f6c1aee9") # mirrors Memory "_CallStateOutput"
extern callstateoutput_3 = InputRef(uuid: "1713f389-0398-fec1-ffff4268f6c1aee9") # mirrors Memory "_CallStateOutput"
extern callstate = VirtualTextIn(iname: "VTI1") # periphery

program = Code16(TextIn1: callstate)

start = Equal(
	In1: callstateoutput_2.AQ, # stale constant 2 kept under the wire
	In2: 2,
)

ringing = Equal(In1: callstateoutput_3.AQ, In2: 1)
callstateoutput = Memory(Type: "analog", In: program.Out1)
callstateuser = Memory(Type: "text", In: program.TextOut1)
callstatedevice = Memory(Type: "text", In: program.TextOut2)
callstatenumber = Memory(Type: "text", In: program.TextOut3)
callonimpuls = Memory(In: call_2.Qon)
calloffimpuls = Memory(In: call_2.Qoff)
callactive = Memory(In: call_2)
call = Or(In1: start, In2: ringing)
call_2 = PushButton("CALL", On: call)
