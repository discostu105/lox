page "Zutritt Eingang"

extern api_connector = ApiActor( # periphery
	title: "API Connector",
	In: code_touch_eingang.OutputAPI,
)

extern tueroeffner_haustuer = Actor(iname: "Q1", In: code_touch_eingang.Q1) # periphery

code_touch_eingang = NfcCodeTouch(
	Authentication: 1,
	Brightness: 50,
	PulseTime: 3s,
	OutputAPI: api_connector.In,
)

access code_touch_eingang_access
	user "redacted-2": "Immer"
	user "redacted-3": "Immer"
end

code_touch_eingang.access = code_touch_eingang_access
