page "Energie"

extern total_active_power = ModbusASensor(iname: "AMQ-1") # periphery
extern total_meter_reading_consumption = ModbusASensor(iname: "AMQ-2") # periphery
extern total_meter_reading_delivery = ModbusASensor(iname: "AMQ-3") # periphery
extern total_active_power_2 = ModbusASensor(iname: "AMQ-4") # periphery
extern total_meter_reading_consumption_2 = ModbusASensor(iname: "AMQ-5") # periphery
extern heizstab = Actor(iname: "Q1", In: pv_ueberschuss) # periphery

netz = MeterAbsBi(
	Power: total_active_power,
	ReadingIn: total_meter_reading_consumption,
	ReadingOut: total_meter_reading_delivery,
)

photovoltaik = MeterAbsUni(
	Power: total_active_power_2,
	ReadingIn: total_meter_reading_consumption_2,
)

energiefluss = EFM(ExportPrice: 0, ImportPrice: 0, CO2: 0)
netz_opf_1 = Formula(Formula: "I1*(-1)", In1: netz.OutPower)

pv_ueberschuss = AnalogThresholdTrigger(
	In: netz_opf_1,
	On: 3,
	Off: 0.5,
	PulseTime: 0,
)
