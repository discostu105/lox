page "Heizung Schlafzimmer"

extern temperatur = TreeAsensor(iname: "AI1") # periphery
extern fenster_schlafzimmer = DigitalIn(iname: "I1") # periphery
extern co2 = TreeAsensor(iname: "AI3") # periphery
extern luftfeuchte = TreeAsensor(iname: "AI2") # periphery

extern stellantrieb_schlafzimmer = TreeAactor( # periphery
	iname: "AQ1",
	In: raumregelung_schlafzimmer.Heating,
)

raumregelung_schlafzimmer = HeatIRoomController2(
	Mode: 1,
	RoomTemp: temperatur,
	Window: fenster_schlafzimmer,
	Co2: co2,
	Humidity: luftfeuchte,
	Fan: 0,
	AirDirection: 0,
	ComfortHeat: 0,
	ComfortCool: 0,
	ComfortHeatCool: 0,
	ComfortDeviation: 0,
	ShadeHeat: 0,
	ShadeCool: 0,
	EcoHeat: 0,
	EcoCool: 0,
	EcoDeviation: 0,
	FrostProtection: 0,
	HeatProtection: 0,
	ValveMoveDays: 0,
	ComfortExtend: 0,
	EcoExtend: 0,
	PresenceExtend: 0,
	HeatingSpeed: 0,
	CoolingSpeed: 0,
	WindowDelay: 0,
	ExcessOffset: 0,
)
