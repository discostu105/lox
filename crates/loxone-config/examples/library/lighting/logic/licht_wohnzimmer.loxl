page "Licht Wohnzimmer"

extern taste_rechts_unten = TreeSensor(iname: "I5") # periphery
extern taste_links_unten = TreeSensor(title: "Taste links unten") # periphery
extern bewegung = TreeSensor(title: "Bewegung") # periphery
extern helligkeit = TreeAsensor(title: "Helligkeit") # periphery
extern praesenz = TreeSensor(title: "Präsenz") # periphery
extern deckenlicht = Actor(iname: "Q1", In: licht_wohnzimmer.AQ1) # periphery
extern led_streifen = TreeAactor(title: "LED-Streifen", In: licht_wohnzimmer.AQ2) # periphery

licht_wohnzimmer = LightController2(
	Circuit1: "switch",
	NextMood: taste_rechts_unten,
	PrevMood: taste_links_unten,
	Motion: bewegung,
	Brightness: helligkeit,
	Presence: praesenz,
	BrightnessLimit: 80,
	MotionExtend: 0,
	PresenceTimeout: 0,
	Step: 0,
	StepTime: 0,
	Max: 0,
	DoubleClickTime: 0,
	ManualTimeout: 0,
	MoodMixTime: 0,
	FadingTime: 0,
	BuzzerFade: 0,
	MinColorTemp: 0,
	MaxColorTemp: 0,
	AlarmInterval: 0,
	AlarmBrightness: 0,
)

moods licht_wohnzimmer_moods
	"Viel Licht": all on, AQ2 rgb(100, 100, 100)
	"Lesen": AQ1 on, AQ2 rgb(100, 90, 70)
	"Abendlicht": AQ2 rgb(100, 60, 20)
	"Kino": AQ2 rgb(0, 0, 15)
end

licht_wohnzimmer.moods = licht_wohnzimmer_moods
