# Hidden from the agent. The t_ externs name the fixture objects
# by title, independent of the slugs a solution chooses.

extern t_wind = VirtualIn(title: "Windgeschwindigkeit")
extern t_regen = VirtualIn(title: "Regensensor")
extern t_markise = VirtualOutCmd(title: "Markise einfahren")

test "Markise fährt bei Wind oder Regen ein"
	t_wind.Q = 30
	step 2
	expect t_markise.In == 0
	t_wind.Q = 55
	step 2
	expect t_markise.In == 1
	t_wind.Q = 10
	t_regen.Q = 1
	step 2
	expect t_markise.In == 1
	t_regen.Q = 0
	step 2
	expect t_markise.In == 0
end
