extern wind = VirtualIn(title: "Windgeschwindigkeit")
extern regen = VirtualIn(title: "Regensensor")
extern markise = VirtualOutCmd(title: "Markise einfahren")

page "Logik"

windig = Greater(In1: wind.Q, In2: 40)
gefahr = Or(In1: windig.Q, In2: regen.Q)
sperre = OffDelay("Markise Sperre 10 Minuten", Trigger: gefahr.Q, Time: 10min)

markise.In <- sperre.Q
