page "Logik"

extern raumtemp = VirtualIn(title: "Raumtemperatur Bad")
extern heizung = VirtualOutCmd(title: "Heizung Bad")

kalt = Less(In1: raumtemp.Q, In2: 20)
warm = GreaterEqual(In1: raumtemp.Q, In2: 22)
regler = SRFlipFlop("Heizung Bad Hysterese", Set: kalt.Q, Reset: warm.Q)

heizung.In <- regler.Q
