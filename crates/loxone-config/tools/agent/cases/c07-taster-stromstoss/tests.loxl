# Hidden from the agent. The t_ externs name the fixture objects
# by title, independent of the slugs a solution chooses.

extern t_taster = VirtualIn(title: "Taster Flur")
extern t_licht = VirtualOutCmd(title: "Licht Flur")

test "Taster schaltet das Flurlicht um"
	step 2
	expect t_licht.In == 0
	t_taster.Q = 1
	step 1
	t_taster.Q = 0
	step 2
	expect t_licht.In == 1
	step 60
	expect t_licht.In == 1 # bleibt an
	t_taster.Q = 1
	step 1
	t_taster.Q = 0
	step 2
	expect t_licht.In == 0
end
