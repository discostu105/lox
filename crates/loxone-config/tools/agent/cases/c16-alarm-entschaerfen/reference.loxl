page "Logik"

extern tuer = VirtualIn(title: "Haustür offen")
extern abwesend = VirtualIn(title: "Abwesend")
extern sirene = VirtualOutCmd(title: "Sirene")

einbruch = And(In1: tuer.Q, In2: abwesend.Q)
zuhause = Not(In: abwesend.Q)
ausgeloest = SRFlipFlop("Einbruch erkannt", Set: einbruch.Q, Reset: zuhause.Q)
frist = OnDelay("Entschärfzeit 30 s", Trigger: ausgeloest.Q, Time: 30s)

alarm = Monoflop(
	"Sirene höchstens 3 Minuten",
	Trigger: frist.Q,
	Reset: zuhause.Q,
	Time: 3min,
)

sirene.In <- alarm.Q
