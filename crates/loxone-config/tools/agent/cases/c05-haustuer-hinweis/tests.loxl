# Hidden from the agent. The t_ externs name the fixture objects
# by title, independent of the slugs a solution chooses.

extern t_tuer = VirtualIn(title: "Haustür offen")
extern t_hinweis = VirtualOutCmd(title: "Hinweis Haustür")

test "Hinweis nach 3 Minuten offener Haustür"
	t_tuer.Q = 1
	step 170
	expect t_hinweis.In == 0
	step 20
	expect t_hinweis.In == 1
	t_tuer.Q = 0
	step 2
	expect t_hinweis.In == 0
	t_tuer.Q = 1
	step 60
	expect t_hinweis.In == 0 # die Zeit läuft neu
end
