# Hidden from the agent. The t_ externs name the fixture objects
# by title, independent of the slugs a solution chooses.

extern t_heizstab = VirtualIn(title: "Heizstab an")
extern t_hinweis = VirtualOutCmd(title: "Hinweis Energie Heizstab")

test "Hinweis bei 6 kWh"
	t_heizstab.Q = 1
	tick 1
	tick 3600 # 1 h: 3 kWh
	expect t_hinweis.I == 0
	t_heizstab.Q = 0
	tick 1
	tick 7200 # aus: kein Verbrauch
	expect t_hinweis.I == 0
	t_heizstab.Q = 1
	tick 1
	tick 3500
	expect t_hinweis.I == 0
	tick 200
	expect t_hinweis.I == 1
end
