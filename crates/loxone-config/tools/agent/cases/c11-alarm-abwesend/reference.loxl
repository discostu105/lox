page "Logik"

extern tuer = VirtualIn(title: "Haustür offen")
extern abwesend = VirtualIn(title: "Abwesend")
extern sirene = VirtualOutCmd(title: "Sirene")

einbruch = And(In1: tuer.Q, In2: abwesend.Q)
zuhause = Not(In: abwesend.Q)
alarm = SRFlipFlop("Einbruchalarm", Set: einbruch.Q, Reset: zuhause.Q)

sirene.In <- alarm.Q
