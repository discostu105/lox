extern tuer = VirtualIn(title: "Haustür offen")
extern abwesend = VirtualIn(title: "Abwesend")
extern sirene = VirtualOutCmd(title: "Sirene")

page "Logik"

einbruch = And(
	I1: tuer.Q,
	I2: abwesend.Q,
)

zuhause = Not(
	I: abwesend.Q,
)

alarm = SRFlipFlop(
	"Einbruchalarm",
	InputS: einbruch.Q,
	InputR: zuhause.Q,
)

sirene.I <- alarm.Q
