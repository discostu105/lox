page "Logik"

extern taster = VirtualIn(title: "Taster Flur")
extern bewegung = VirtualIn(title: "Bewegung Flur")
extern helligkeit = VirtualIn(title: "Helligkeit außen")
extern licht = VirtualOutCmd(title: "Licht Flur")

schalter = PushButton("Flurlicht", Toggle: taster.Q)
dunkel = Less(In1: helligkeit.Q, In2: 50)
bewegung_dunkel = And(In1: bewegung.Q, In2: dunkel.Q)
nachlauf = OffDelay("Flurlicht Bewegung", Trigger: bewegung_dunkel.Q, Time: 3min)
an = Or(In1: schalter.Q, In2: nachlauf.Q)

licht.In <- an.Q
