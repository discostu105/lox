extern melder = VirtualIn(title: "Wassermelder Keller")
extern sirene = VirtualOutCmd(title: "Sirene")
extern entfeuchter = VirtualOutCmd(title: "Entfeuchter Keller")

page "Logik"

alarm = Monoflop("Sirene Wasseralarm", InputTrigger: melder.Q, Time: 60s)

sirene.I <- alarm.Q
entfeuchter.I <- melder.Q
