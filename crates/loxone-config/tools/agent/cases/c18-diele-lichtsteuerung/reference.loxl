extern bewegung = VirtualIn(title: "Bewegung Diele")
extern helligkeit = VirtualIn(title: "Helligkeit Diele")
extern taster_aus = VirtualIn(title: "Taster Diele aus")
extern licht = VirtualOutCmd(title: "Licht Diele")

page "Logik"

lichtsteuerung = LightController2(
	"Lichtsteuerung Diele",
	Motion: bewegung.Q,
	Brightness: helligkeit.Q,
	Reset: taster_aus.Q,
	BrightnessLimit: 50,
	MotionExtend: 120,
	ManualTimeout: 3600,
)

licht.In <- lichtsteuerung.AQ1

moods diele
	"Viel Licht": AQ1 on
end

lichtsteuerung.moods = diele
