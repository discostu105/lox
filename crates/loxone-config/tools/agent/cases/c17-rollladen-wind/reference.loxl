page "Logik"

extern taster_auf = VirtualIn(title: "Taster Rollladen auf")
extern taster_ab = VirtualIn(title: "Taster Rollladen ab")
extern wind = VirtualIn(title: "Windgeschwindigkeit")
extern motor_auf = VirtualOutCmd(title: "Rollladen Wohnzimmer auf")
extern motor_ab = VirtualOutCmd(title: "Rollladen Wohnzimmer ab")

sturm = Greater(In1: wind.Q, In2: 50)

rollladen = AutoJalousie(
	"Rollladen Wohnzimmer",
	EndUp: taster_auf.Q,
	EndDown: taster_ab.Q,
	Safety: sturm.Q,
	Type: 1,
	OpenTime: 40,
	CloseTime: 35,
)

motor_auf.In <- rollladen.MotorUp
motor_ab.In <- rollladen.MotorDown
