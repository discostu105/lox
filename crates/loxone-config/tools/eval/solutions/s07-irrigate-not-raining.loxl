page "Garten"

extern feuchte = VirtualIn(iname: "VI3")
extern regen = SysVar(title: "Regen")
extern ventil = VirtualOut(title: "Bewässerungsventil")

trocken = Less("Boden trocken", In1: feuchte.AQ, In2: 30)
kein_regen = Not(In: regen.AQ)
giessen = And("Gießen", In1: trocken.Q, In2: kein_regen.Q)

ventil.I1 <- giessen.Q
