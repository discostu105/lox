page "Wohnzimmer"

extern sonne = SysVar(title: "Sonnenschein")
extern regen = SysVar(title: "Regen")
extern jalousie = JalousieUpDown2(uuid: "70000011-0011-0001-ffff000000000001")

kein_regen = Not(In: regen.AQ)
schliessen = And("Sonne ohne Regen", In1: sonne.AQ, In2: kein_regen.Q)

jalousie.InputTriggerDown <- schliessen.Q
