# Klima — Vorlagen für Heizung, Lüftung und Entfeuchtung.
#
# Kopiere die Datei in das Modulverzeichnis des Projekts und rufe eine
# Vorlage mit einer Zeile auf. Sensoren werden an ihrem Ausgang `Q`
# gelesen; das Ergebnis jeder Vorlage ist ihr Hauptblock `ausgang`, die Instanz selbst:
#
#   bad = heizung_hysterese(temperatur: raumtemp_bad, ein: 20, aus: 22)
#   heizung_bad.I <- bad.Q

template heizung_hysterese(temperatur: any, ein = 20, aus = 22, titel = "Heizung")
	# Heizen unter `ein` °C, aufhören ab `aus` °C (ein < aus).

	ausgang = AnalogThresholdTrigger(
		"{titel}",
		Input: temperatur.Q,
		On: ein,
		Off: aus,
	)
end

template frostschutz(temperatur: any, grenze = 5)
	# Frostschutz: ein unter `grenze` °C.

	ausgang = Less(
		Input1: temperatur.Q,
		Input2: grenze,
	)
end

template lueftung_co2(co2: any, fenster: any, grenze = 1000, verzoegerung = 5min, titel = "CO2 hoch") -> ausgang
	# Lüften, wenn CO2 `verzoegerung` lang über `grenze` ppm liegt und das
	# Fenster zu ist.

	hoch = Greater(
		Input1: co2.Q,
		Input2: grenze,
	)

	lange = OnDelay(
		"{titel}",
		InputTrigger: hoch.Q,
		Time: verzoegerung,
	)

	zu = Not(
		I: fenster.Q,
	)

	ausgang = And(
		I1: lange.Q,
		I2: zu.Q,
	)
end

template entfeuchter(feuchte: any, ein = 65, aus = 55, titel = "Entfeuchter")
	# Entfeuchten ab `ein` % relativer Feuchte, bis sie unter `aus` % fällt
	# (ein > aus).

	ausgang = AnalogThresholdTrigger(
		"{titel}",
		Input: feuchte.Q,
		On: ein,
		Off: aus,
	)
end
