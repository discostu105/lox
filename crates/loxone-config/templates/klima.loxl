# Klima — Vorlagen für Heizung, Lüftung und Entfeuchtung.
#
# Kopiere die Datei in das Modulverzeichnis des Projekts und rufe eine
# Vorlage mit einer Zeile auf. Sensoren werden an ihrem Ausgang `Q`
# gelesen; das Ergebnis jeder Vorlage ist ihr Ausgang `Q`:
#
#   bad = HeizungHysterese(temperatur: raumtemp_bad, ein: 20, aus: 22)
#   heizung_bad.I <- bad.Q

template HeizungHysterese(temperatur: any, ein: number = 20, aus: number = 22, titel: string = "Heizung") -> (Q: ausgang.Q)
	# Heizen unter `ein` °C, aufhören ab `aus` °C (ein < aus).

	ausgang = AnalogThresholdTrigger(
		"{titel}",
		In: temperatur.Q,
		On: ein,
		Off: aus,
	)
end

template Frostschutz(temperatur: any, grenze: number = 5) -> (Q: ausgang.Q)
	# Frostschutz: ein unter `grenze` °C.

	ausgang = Less(In1: temperatur.Q, In2: grenze)
end

template LueftungCo2(co2: any, fenster: any, grenze: number = 1000, verzoegerung: duration = 5min, titel: string = "CO2 hoch") -> (Q: ausgang.Q)
	# Lüften, wenn CO2 `verzoegerung` lang über `grenze` ppm liegt und das
	# Fenster zu ist.

	hoch = Greater(In1: co2.Q, In2: grenze)
	lange = OnDelay("{titel}", Trigger: hoch.Q, Time: verzoegerung)
	zu = Not(In: fenster.Q)
	ausgang = And(In1: lange.Q, In2: zu.Q)
end

template Entfeuchter(feuchte: any, ein: number = 65, aus: number = 55, titel: string = "Entfeuchter") -> (Q: ausgang.Q)
	# Entfeuchten ab `ein` % relativer Feuchte, bis sie unter `aus` % fällt
	# (ein > aus).

	ausgang = AnalogThresholdTrigger(
		"{titel}",
		In: feuchte.Q,
		On: ein,
		Off: aus,
	)
end
