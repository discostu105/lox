# Tests der Sicherheitsvorlagen (templates/sicherheit.loxl) im Simulator.

page "Logik"

tuer = VirtualIn("Haustür offen")
melder = VirtualIn("Wassermelder")
abwesend = VirtualIn("Abwesend")

hinweis = TuerOffenHinweis(kontakt: tuer)
wasser = Wasseralarm(melder: melder)
alarm = AlarmAbwesend(kontakt: tuer, abwesend: abwesend)

test "tuer_offen_hinweis: nach 3 Minuten"
	tuer.Q = 1
	step 170
	expect hinweis.Q == 0
	step 20
	expect hinweis.Q == 1
	tuer.Q = 0
	step 2
	expect hinweis.Q == 0
end

test "wasseralarm: 60 Sekunden"
	melder.Q = 1
	step 2
	expect wasser.Q == 1
	step 70
	expect wasser.Q == 0
end

test "alarm_abwesend: nach der Frist, höchstens 3 Minuten"
	abwesend.Q = 1
	step 2
	tuer.Q = 1
	step 2
	tuer.Q = 0
	step 20
	expect alarm.Q == 0
	step 15
	expect alarm.Q == 1
	step 150
	expect alarm.Q == 1
	step 40
	expect alarm.Q == 0
end

test "alarm_abwesend: rechtzeitig entschärft"
	abwesend.Q = 1
	step 2
	tuer.Q = 1
	step 10
	abwesend.Q = 0
	step 60
	expect alarm.Q == 0
end
