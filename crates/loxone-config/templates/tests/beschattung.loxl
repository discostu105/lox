# Tests der Beschattungsvorlagen (templates/beschattung.loxl) im Simulator.

page "Logik"

wind = VirtualIn("Windgeschwindigkeit")
regen = VirtualIn("Regen")
helligkeit = VirtualIn("Helligkeit")
aussentemp = VirtualIn("Außentemperatur")

markise = markise_schutz(wind: wind, regen: regen)
sonne = sonnenschutz(helligkeit: helligkeit, aussentemp: aussentemp)

test "markise_schutz: sofort ein, Freigabe nach 10 ruhigen Minuten"
	wind.Q = 55
	step 2
	expect markise.Q == 1
	wind.Q = 10
	step 300
	expect markise.Q == 1
	regen.Q = 1
	step 2
	regen.Q = 0
	step 500
	expect markise.Q == 1
	step 120
	expect markise.Q == 0
end

test "sonnenschutz: hell und warm"
	helligkeit.Q = 50000
	aussentemp.Q = 20
	step 2
	expect sonne.Q == 0
	aussentemp.Q = 28
	step 2
	expect sonne.Q == 1
	helligkeit.Q = 5000
	step 2
	expect sonne.Q == 0
end
