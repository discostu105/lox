# Tests der Klimavorlagen (templates/klima.loxl) im Simulator.

page "Logik"

temperatur = VirtualIn("Raumtemperatur")
co2 = VirtualIn("CO2")
fenster = VirtualIn("Fenster offen")
feuchte = VirtualIn("Luftfeuchte")

heizung = HeizungHysterese(temperatur: temperatur)
frost = Frostschutz(temperatur: temperatur)
lueftung = LueftungCo2(co2: co2, fenster: fenster)
keller = Entfeuchter(feuchte: feuchte)

test "heizung_hysterese: zwischen den Schwellen bleibt der Zustand"
	temperatur.Q = 19
	step 2
	expect heizung.Q == 1
	temperatur.Q = 21
	step 2
	expect heizung.Q == 1
	temperatur.Q = 22.5
	step 2
	expect heizung.Q == 0
	temperatur.Q = 21
	step 2
	expect heizung.Q == 0
end

test "frostschutz"
	temperatur.Q = 8
	step 2
	expect frost.Q == 0
	temperatur.Q = 3
	step 2
	expect frost.Q == 1
end

test "lueftung_co2: nach 5 Minuten, nur bei geschlossenem Fenster"
	co2.Q = 1400
	step 240
	expect lueftung.Q == 0
	step 70
	expect lueftung.Q == 1
	fenster.Q = 1
	step 2
	expect lueftung.Q == 0
end

test "entfeuchter: Hysterese"
	feuchte.Q = 70
	step 2
	expect keller.Q == 1
	feuchte.Q = 60
	step 2
	expect keller.Q == 1
	feuchte.Q = 50
	step 2
	expect keller.Q == 0
	feuchte.Q = 60
	step 2
	expect keller.Q == 0
end
