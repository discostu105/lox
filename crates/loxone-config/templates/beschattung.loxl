# Beschattung — Vorlagen zum Schutz von Markise und Jalousie.
#
# Kopiere die Datei in das Modulverzeichnis des Projekts und rufe eine
# Vorlage mit einer Zeile auf. Sensoren werden an ihrem Ausgang `Q`
# gelesen; das Ergebnis jeder Vorlage ist ihr Ausgang `Q`:
#
#   markise = MarkiseSchutz(wind: windgeschwindigkeit, regen: regensensor)
#   markise_ein.I <- markise.Q

template MarkiseSchutz(wind: any, regen: any, grenze: number = 40, freigabe: duration = 10min, titel: string = "Markise Sperre") -> (Q: ausgang.Q)
	# Einfahren sofort bei Wind über `grenze` km/h oder Regen; wieder
	# freigeben erst nach `freigabe` ohne beides.

	windig = Greater(In1: wind.Q, In2: grenze)
	gefahr = Or(In1: windig.Q, In2: regen.Q)
	ausgang = OffDelay("{titel}", Trigger: gefahr.Q, Time: freigabe)
end

template Sonnenschutz(helligkeit: any, aussentemp: any, lux: number = 30000, temperatur: number = 24) -> (Q: ausgang.Q)
	# Sonnenschutz: beschatten, wenn die Helligkeit über `lux` und die
	# Außentemperatur über `temperatur` °C liegt.

	hell = Greater(In1: helligkeit.Q, In2: lux)
	warm = Greater(In1: aussentemp.Q, In2: temperatur)
	ausgang = And(In1: hell.Q, In2: warm.Q)
end
