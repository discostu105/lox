# Licht — Vorlagen für Bewegungs- und Tasterlicht.
#
# Kopiere die Datei in das Modulverzeichnis des Projekts und rufe eine
# Vorlage mit einer Zeile auf. Sensoren werden an ihrem Ausgang `Q`
# gelesen (virtuelle Eingänge, digitale Eingänge); das Ergebnis jeder
# Vorlage ist ihr Hauptblock `ausgang`, die Instanz selbst:
#
#   flur = bewegungslicht_dunkel(bewegung: bewegung_flur, helligkeit: lux)
#   licht_flur.I <- flur.Q

template bewegungslicht(bewegung: any, nachlauf = 3min, titel = "Bewegungslicht")
	# Licht an bei Bewegung, aus `nachlauf` nach der letzten Bewegung.

	ausgang = OffDelay(
		"{titel}",
		InputTrigger: bewegung.Q,
		Time: nachlauf,
	)
end

template bewegungslicht_dunkel(bewegung: any, helligkeit: any, lux = 50, nachlauf = 3min, titel = "Bewegungslicht") -> ausgang
	# Wie bewegungslicht, aber nur wenn die Helligkeit unter `lux` liegt.

	dunkel = Less(
		Input1: helligkeit.Q,
		Input2: lux,
	)

	bewegt = And(
		I1: bewegung.Q,
		I2: dunkel.Q,
	)

	ausgang = OffDelay(
		"{titel}",
		InputTrigger: bewegt.Q,
		Time: nachlauf,
	)
end

template taster_licht(taster: any, titel = "Tasterlicht")
	# Jeder Tastendruck schaltet um (Stromstoß).

	ausgang = PushButton(
		"{titel}",
		InputTrigger: taster.Q,
	)
end

template treppenlicht(taster: any, dauer = 3min, titel = "Treppenlicht")
	# Treppenlicht: ein Druck schaltet für `dauer` ein, ein weiterer verlängert.

	ausgang = Monoflop(
		"{titel}",
		InputTrigger: taster.Q,
		Time: dauer,
	)
end
