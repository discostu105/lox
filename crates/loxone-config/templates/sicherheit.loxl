# Sicherheit — Vorlagen für Türhinweis, Wasser- und Einbruchalarm.
#
# Kopiere die Datei in das Modulverzeichnis des Projekts und rufe eine
# Vorlage mit einer Zeile auf. Sensoren werden an ihrem Ausgang `Q`
# gelesen; das Ergebnis jeder Vorlage ist ihr Ausgang `Q`:
#
#   haustuer = TuerOffenHinweis(kontakt: haustuer_offen, nach: 3min)
#   hinweis.I <- haustuer.Q

template TuerOffenHinweis(kontakt: any, nach: duration = 3min, titel: string = "Tür offen") -> (Q: ausgang.Q)
	# Hinweis, wenn die Tür länger als `nach` offen steht.

	ausgang = OnDelay("{titel}", Trigger: kontakt.Q, Time: nach)
end

template Wasseralarm(melder: any, dauer: duration = 60s, titel: string = "Wasseralarm") -> (Q: ausgang.Q)
	# Wasseralarm: der Melder löst die Sirene für `dauer` aus.

	ausgang = Monoflop("{titel}", Trigger: melder.Q, Time: dauer)
end

template AlarmAbwesend(kontakt: any, abwesend: any, frist: duration = 30s, dauer: duration = 3min, titel: string = "Einbruch") -> (Q: ausgang.Q)
	# Einbruchalarm: Kontakt bei aktivem `abwesend` → nach `frist` die
	# Sirene, höchstens `dauer` lang. Ausschalten von `abwesend` beendet den
	# Alarm und entschärft innerhalb der Frist.

	einbruch = And(In1: kontakt.Q, In2: abwesend.Q)
	zuhause = Not(In: abwesend.Q)
	erkannt = SRFlipFlop("{titel} erkannt", Set: einbruch.Q, Reset: zuhause.Q)
	verzoegert = OnDelay("{titel} Entschärfzeit", Trigger: erkannt.Q, Time: frist)

	ausgang = Monoflop(
		"{titel} Sirene",
		Trigger: verzoegert.Q,
		Reset: zuhause.Q,
		Time: dauer,
	)
end
