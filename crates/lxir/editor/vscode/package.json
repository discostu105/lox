{
  "name": "lxir",
  "displayName": "lxir",
  "description": "Syntax highlighting, snippets and the lxir language server for lxir modules (.lxir) — Loxone config-as-code",
  "version": "0.2.0",
  "publisher": "lxir",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lxir",
        "aliases": [
          "lxir"
        ],
        "extensions": [
          ".lxir"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lxir",
        "scopeName": "source.lxir",
        "path": "./syntaxes/lxir.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lxir",
        "path": "./snippets/lxir.json"
      }
    ],
    "configuration": {
      "title": "lxir",
      "properties": {
        "lxir.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "Start the lxir language server for .lxir files."
        },
        "lxir.server.path": {
          "type": "string",
          "default": "lxir",
          "description": "The program that runs the language server: `lxir`, or `lox` (with the arguments `ir lsp`)."
        },
        "lxir.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Its arguments: `[\"lsp\"]` for lxir, `[\"ir\", \"lsp\"]` for lox."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lxir"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
