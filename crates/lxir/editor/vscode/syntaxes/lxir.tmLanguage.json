{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "lxir",
  "scopeName": "source.lxir",
  "patterns": [
    { "include": "#comment" },
    { "include": "#template" },
    { "include": "#test" },
    { "include": "#tiles" },
    { "include": "#end" },
    { "include": "#page" },
    { "include": "#extern" },
    { "include": "#let" },
    { "include": "#removed" },
    { "include": "#moved" },
    { "include": "#block" },
    { "include": "#instance" },
    { "include": "#wire" },
    { "include": "#attr" },
    { "include": "#set" },
    { "include": "#exprops" },
    { "include": "#portref" },
    { "include": "#string" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.lxir",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.lxir",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lxir",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },
    "number": {
      "match": "(?<![\\w.])(-?[0-9]+(?:\\.[0-9]+)?)(ms|min|h|s|K|%)?(?![\\w.])",
      "captures": {
        "1": { "name": "constant.numeric.lxir" },
        "2": { "name": "keyword.other.unit.lxir" }
      }
    },
    "exprops": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lxir",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.lxir",
          "match": ">=|<=|==|!=|~=|<(?!-)|>"
        },
        {
          "name": "keyword.operator.arithmetic.lxir",
          "match": "[+*/]|(?<=[\\w)])\\s*-(?![0-9>])"
        }
      ]
    },
    "portref": {
      "match": "([a-z][a-z0-9_]*)(\\.)([A-Za-z0-9_]+)",
      "captures": {
        "1": { "name": "variable.other.lxir" },
        "2": { "name": "punctuation.accessor.lxir" },
        "3": { "name": "variable.other.member.lxir" }
      }
    },
    "page": {
      "match": "^\\s*(page)\\b",
      "captures": {
        "1": { "name": "keyword.control.page.lxir" }
      }
    },
    "template": {
      "begin": "^\\s*(template)\\s+([a-z][a-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.template.lxir" },
        "2": { "name": "entity.name.function.lxir" },
        "3": { "name": "punctuation.definition.parameters.begin.lxir" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.lxir" }
      },
      "patterns": [
        {
          "match": "([a-z][a-z0-9_]*)\\s*(:)\\s*([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "variable.parameter.lxir" },
            "2": { "name": "punctuation.separator.lxir" },
            "3": { "name": "entity.name.type.lxir" }
          }
        },
        {
          "match": "([a-z][a-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.parameter.lxir" },
            "2": { "name": "keyword.operator.assignment.lxir" }
          }
        },
        { "include": "#string" },
        { "include": "#number" }
      ]
    },
    "end": {
      "name": "keyword.control.end.lxir",
      "match": "^\\s*(end)\\s*$"
    },
    "test": {
      "patterns": [
        {
          "match": "^\\s*(test)\\s+(?=\")",
          "captures": {
            "1": { "name": "keyword.control.test.lxir" }
          }
        },
        {
          "match": "^\\s*(tick)\\s+([0-9]+)(?:\\s+(dt)\\b)?",
          "captures": {
            "1": { "name": "keyword.control.tick.lxir" },
            "2": { "name": "constant.numeric.lxir" },
            "3": { "name": "keyword.control.dt.lxir" }
          }
        },
        {
          "match": "^\\s*(expect)\\b",
          "captures": {
            "1": { "name": "keyword.control.expect.lxir" }
          }
        },
        {
          "match": "^\\s*(clock)\\s+(?=\")",
          "captures": {
            "1": { "name": "keyword.control.clock.lxir" }
          }
        }
      ]
    },
    "tiles": {
      "comment": "tiles <name> … end with tile <i>(…) entries (D41)",
      "patterns": [
        {
          "match": "^\\s*(tiles)\\s+([a-z][a-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.tiles.lxir" },
            "2": { "name": "entity.name.function.lxir" }
          }
        },
        {
          "match": "^\\s*(tile)\\s+([0-9]+)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.control.tile.lxir" },
            "2": { "name": "constant.numeric.lxir" }
          }
        },
        {
          "match": "\\b((?:click|up|down)(?:_(?:text|to))?|text|to)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.lxir" },
            "2": { "name": "punctuation.separator.lxir" }
          }
        }
      ]
    },
    "file": {
      "comment": "file(\"…\") — program text from a file (D40); one match, so its ) never closes the argument list",
      "match": "\\b(file)\\s*(\\()\\s*(\"[^\"]*\")\\s*(\\))",
      "captures": {
        "1": { "name": "support.function.builtin.lxir" },
        "2": { "name": "punctuation.definition.arguments.begin.lxir" },
        "3": { "name": "string.quoted.double.lxir" },
        "4": { "name": "punctuation.definition.arguments.end.lxir" }
      }
    },
    "extern": {
      "match": "^\\s*(extern)\\s+([a-z][a-z0-9_]*)\\s*(=)\\s*([A-Z][A-Za-z0-9]*)\\s*(\\()\\s*(uuid|iname|title)\\s*(:)",
      "captures": {
        "1": { "name": "keyword.control.extern.lxir" },
        "2": { "name": "entity.name.function.lxir" },
        "3": { "name": "keyword.operator.assignment.lxir" },
        "4": { "name": "entity.name.type.lxir" },
        "5": { "name": "punctuation.definition.arguments.begin.lxir" },
        "6": { "name": "constant.language.matchkind.lxir" },
        "7": { "name": "punctuation.separator.lxir" }
      }
    },
    "block": {
      "begin": "^\\s*([a-z][a-z0-9_]*)\\s*(=)\\s*([A-Z][A-Za-z0-9]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.function.lxir" },
        "2": { "name": "keyword.operator.assignment.lxir" },
        "3": { "name": "entity.name.type.lxir" },
        "4": { "name": "punctuation.definition.arguments.begin.lxir" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.arguments.end.lxir" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#file" },
        { "include": "#string" },
        {
          "match": "([A-Za-z][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.lxir" },
            "2": { "name": "punctuation.separator.lxir" }
          }
        },
        { "include": "#exprops" },
        { "include": "#portref" },
        { "include": "#number" }
      ]
    },
    "instance": {
      "begin": "^\\s*([a-z][a-z0-9_]*)\\s*(=)\\s*([a-z][a-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.function.lxir" },
        "2": { "name": "keyword.operator.assignment.lxir" },
        "3": { "name": "entity.name.function.template.lxir" },
        "4": { "name": "punctuation.definition.arguments.begin.lxir" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.arguments.end.lxir" }
      },
      "patterns": [
        { "include": "#comment" },
        { "include": "#file" },
        { "include": "#string" },
        {
          "match": "([a-z][a-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.lxir" },
            "2": { "name": "punctuation.separator.lxir" }
          }
        },
        { "include": "#portref" },
        { "include": "#number" }
      ]
    },
    "wire": {
      "match": "^\\s*([a-z][a-z0-9_]*)(\\.)([A-Za-z0-9_]+)\\s*(<-)",
      "captures": {
        "1": { "name": "variable.other.lxir" },
        "2": { "name": "punctuation.accessor.lxir" },
        "3": { "name": "variable.other.member.lxir" },
        "4": { "name": "keyword.operator.arrow.lxir" }
      }
    },
    "attr": {
      "match": "^\\s*([a-z][a-z0-9_]*)(\\.)(title|room|category|tiles)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.lxir" },
        "2": { "name": "punctuation.accessor.lxir" },
        "3": { "name": "support.type.property-name.lxir" },
        "4": { "name": "keyword.operator.assignment.lxir" }
      }
    },
    "set": {
      "match": "^\\s*([a-z][a-z0-9_]*)(\\.)([A-Za-z0-9_]+)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.lxir" },
        "2": { "name": "punctuation.accessor.lxir" },
        "3": { "name": "variable.other.member.lxir" },
        "4": { "name": "keyword.operator.assignment.lxir" }
      }
    },
    "let": {
      "match": "^\\s*(let)\\s+([a-z][a-z0-9_]*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.control.let.lxir" },
        "2": { "name": "variable.other.constant.lxir" },
        "3": { "name": "keyword.operator.assignment.lxir" }
      }
    },
    "removed": {
      "match": "^\\s*(removed)\\s+([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.removed.lxir" },
        "2": { "name": "variable.other.lxir" }
      }
    },
    "moved": {
      "match": "^\\s*(moved)\\s+([a-z][a-z0-9_]*)\\s*(->)\\s*([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.moved.lxir" },
        "2": { "name": "variable.other.lxir" },
        "3": { "name": "keyword.operator.arrow.lxir" },
        "4": { "name": "variable.other.lxir" }
      }
    }
  }
}
